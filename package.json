{
  "name": "cross-region-resource",
  "version": "0.1.2",
  "author": {
    "name": "Dmitri Poujlivyi",
    "email": "dmitri.poujlivyi@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "https://bitbucket.org/dmninaz/cross-region-resource.git"
  },
  "license": "GPL-3.0-only",
  "files": [
    "lib",
    ".jsii"
  ],
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "bin": {
    "cross-region-resource": "bin/cross-region-resource.js"
  },
  "scripts": {
    "build": "tsc && jsii && esbuild lib/cross-region-reader.handler.ts --bundle --platform=node --target=node22 --external:@aws-sdk/client-s3 --outfile=lib/handlers/reader.js && esbuild lib/cross-region-writer.handler.ts --bundle --platform=node --target=node22 --external:@aws-sdk/client-s3 --outfile=lib/handlers/writer.js",
    "watch": "jsii --watch",
    "test": "jest",
    "cdk": "cdk",
    "package": "jsii-pacmak"
  },
  "jsii": {
    "outdir": "dist",
    "tsc": {
      "types": [
        "node",
        "jest"
      ]
    },
    "targets": {
      "java": {
        "package": "net.koderllc.crossregionresource",
        "maven": {
          "groupId": "net.koderllc",
          "artifactId": "cross-region-resource"
        }
      }
    }
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1037.0",
    "@types/aws-lambda": "^8.10.161",
    "@types/jest": "^30",
    "@types/node": "^25.6.0",
    "aws-cdk": "2.1143.0",
    "aws-cdk-lib": "2.271.0",
    "constructs": "10.8.1",
    "esbuild": "^0.28.0",
    "jest": "^30.0.0",
    "jsii": "^5.9.37",
    "jsii-pacmak": "^1.128.0",
    "ts-jest": "^29.0.0",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.3"
  },
  "peerDependencies": {
    "aws-cdk-lib": "^2.271.0",
    "constructs": "^10.8.1"
  }
}
